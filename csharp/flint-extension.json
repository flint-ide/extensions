{
  "contract": 1,
  "id": "flint.csharp",
  "name": "C#",
  "version": "0.1.0",
  "publisher": "Flint",
  "description": "C# in the editor: highlighting, comments, and completion, go to definition and diagnostics through csharp-ls or OmniSharp.",
  "contributes": {
    "languages": [
      {
        "id": "csharp",
        "label": "C#",
        "extensions": [".cs", ".csx"],
        "lineComment": "//",
        "blockComment": ["/*", "*/"],
        "server": {
          "candidates": [["csharp-ls"], ["OmniSharp", "-lsp"]],
          "install": "dotnet tool install --global csharp-ls   (or OmniSharp from github.com/OmniSharp/omnisharp-roslyn/releases)"
        },
        "grammar": {
          "states": {
            "start": [
              { "regex": "\\s*#\\s*(?:if|elif|else|endif|define|undef|region|endregion|pragma|nullable|warning|error|line)\\b.*", "token": "meta", "sol": true },
              { "regex": "\\s*\\[(?:assembly|module|return|field|property|method|type|param):\\s*[A-Za-z_][\\w.]*", "token": "attribute", "sol": true },
              { "regex": "\\s*\\[[A-Z][\\w.]*(?=[\\](,])", "token": "attribute", "sol": true },
              { "regex": "//.*", "token": "comment" },
              { "regex": "/\\*", "token": "comment", "push": "blockComment" },
              { "regex": "\\$*\"\"\"", "token": "string", "push": "rawString" },
              { "regex": "\\$@\"|@\\$\"", "token": "string", "push": "verbatimInterp" },
              { "regex": "@\"", "token": "string", "push": "verbatim" },
              { "regex": "\\$\"", "token": "string", "push": "interp" },
              { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"?", "token": "string" },
              { "regex": "'(?:[^'\\\\]|\\\\.)*'", "token": "string" },
              { "regex": "@[A-Za-z_]\\w*", "token": "variable" },
              { "regex": "\\b(?:class|struct|interface|enum|record|namespace)\\b", "token": "keyword", "push": "defName" },
              { "regex": "\\b(?:abstract|as|base|break|case|catch|checked|const|continue|default|delegate|do|else|event|explicit|extern|finally|fixed|for|foreach|goto|if|implicit|in|internal|is|lock|new|operator|out|override|params|private|protected|public|readonly|ref|return|sealed|sizeof|stackalloc|static|switch|this|throw|try|typeof|unchecked|unsafe|using|virtual|volatile|while)\\b", "token": "keyword" },
              { "regex": "\\b(?:async|await|var|get|set|init|value|yield|partial|required|when|where|nameof|global|with|not|and|or|file|scoped|add|remove|alias|managed|unmanaged|notnull)\\b", "token": "keyword" },
              { "regex": "\\b(?:true|false|null)\\b", "token": "atom" },
              { "regex": "\\b(?:bool|byte|sbyte|char|decimal|double|float|int|uint|long|ulong|short|ushort|nint|nuint|object|string|void|dynamic)\\b", "token": "type" },
              { "regex": "I[A-Z][a-z]\\w*", "token": "type" },
              { "regex": "[A-Z]\\w*(?=<|\\[\\]|\\s+[A-Za-z_@])", "token": "type" },
              { "regex": "0[xX][0-9a-fA-F_]+[uUlL]{0,2}|0[bB][01_]+[uUlL]{0,2}|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[fFdDmMuUlL]{0,2}|\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?[fFdDmM]?", "token": "number" },
              { "regex": "[A-Za-z_]\\w*", "token": "variable" },
              { "regex": "\\?\\?=?|\\?\\.|=>|==|!=|<=|>=|&&|\\|\\||\\+\\+|--|<<=?|>>>?=?|->|::|[-+*/%&|^!~<>=?:]=?", "token": "operator" },
              { "regex": "[()\\[\\]{}]", "token": "bracket" },
              { "regex": "[,;.]", "token": "punctuation" }
            ],
            "blockComment": [
              { "regex": "\\*/", "token": "comment", "pop": true },
              { "regex": "[^*]+", "token": "comment" },
              { "regex": "\\*", "token": "comment" }
            ],
            "defName": [
              { "regex": "\\s+" },
              { "regex": "(?:class|struct)\\b", "token": "keyword" },
              { "regex": "[A-Za-z_][\\w.]*", "token": "def", "pop": true },
              { "regex": "[()\\[\\]{}]", "token": "bracket", "pop": true },
              { "regex": "[^\\s]", "pop": true }
            ],
            "verbatim": [
              { "regex": "\"\"", "token": "string-2" },
              { "regex": "\"", "token": "string", "pop": true },
              { "regex": "[^\"]+", "token": "string" }
            ],
            "interp": [
              { "regex": "\\\\.", "token": "string-2" },
              { "regex": "\\{\\{|\\}\\}", "token": "string-2" },
              { "regex": "\\{", "token": "meta", "push": "interpolation" },
              { "regex": "\"", "token": "string", "pop": true },
              { "regex": "[^\"\\\\{}]+|\\}", "token": "string" }
            ],
            "verbatimInterp": [
              { "regex": "\"\"|\\{\\{|\\}\\}", "token": "string-2" },
              { "regex": "\\{", "token": "meta", "push": "interpolation" },
              { "regex": "\"", "token": "string", "pop": true },
              { "regex": "[^\"{}]+|\\}", "token": "string" }
            ],
            "rawString": [
              { "regex": "\"\"\"", "token": "string", "pop": true },
              { "regex": "[^\"]+|\"", "token": "string" }
            ],
            "interpolation": [
              { "regex": "\\}", "token": "meta", "pop": true },
              { "regex": "\\{", "token": "bracket", "push": "interpolation" },
              { "regex": "\"(?:[^\"\\\\]|\\\\.)*\"", "token": "string" },
              { "regex": "'(?:[^'\\\\]|\\\\.)*'", "token": "string" },
              { "regex": "\\b(?:true|false|null)\\b", "token": "atom" },
              { "regex": "\\d[\\d_]*(?:\\.\\d+)?", "token": "number" },
              { "regex": "[A-Za-z_]\\w*", "token": "variable" },
              { "regex": "[^{}\"'\\w]+" }
            ]
          }
        }
      }
    ]
  }
}

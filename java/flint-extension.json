{
  "contract": 1,
  "id": "flint.java",
  "name": "Java",
  "version": "0.1.0",
  "publisher": "Flint",
  "description": "Java in the editor: highlighting, comments, and completion, go to definition and diagnostics through Eclipse JDT LS (jdtls).",
  "contributes": {
    "languages": [
      {
        "id": "java",
        "label": "Java",
        "extensions": [".java"],
        "lineComment": "//",
        "blockComment": ["/*", "*/"],
        "server": {
          "candidates": [["jdtls"]],
          "install": "brew install jdtls   (or unpack Eclipse JDT LS and put its bin folder on PATH)"
        },
        "grammar": {
          "states": {
            "start": [
              { "regex": "/\\*\\*(?!/)", "token": "comment", "push": "docComment" },
              { "regex": "/\\*", "token": "comment", "push": "blockComment" },
              { "regex": "//.*", "token": "comment" },
              { "regex": "\"\"\"", "token": "string", "push": "textBlock" },
              { "regex": "\"(?=(?:[^\"\\\\]|\\\\.)*\")", "token": "string", "push": "string" },
              { "regex": "\"(?:[^\"\\\\]|\\\\.)*", "token": "string" },
              { "regex": "'(?:[^'\\\\]|\\\\u+[0-9a-fA-F]{4}|\\\\[0-7]{1,3}|\\\\.)'", "token": "string" },
              { "regex": "@interface\\b", "token": "keyword", "push": "defName" },
              { "regex": "@[A-Za-z_$][\\w$.]*", "token": "meta" },
              { "regex": "(?:class|interface|enum|record)\\b(?=\\s+[A-Za-z_$])", "token": "keyword", "push": "defName" },
              { "regex": "non-sealed\\b", "token": "keyword" },
              { "regex": "(?:abstract|assert|break|case|catch|class|const|continue|default|do|else|enum|extends|final|finally|for|goto|if|implements|import|instanceof|interface|native|new|package|permits|private|protected|public|return|sealed|static|strictfp|super|switch|synchronized|this|throw|throws|transient|try|var|volatile|while|yield)\\b", "token": "keyword" },
              { "regex": "(?:boolean|byte|char|double|float|int|long|short|void)\\b", "token": "type" },
              { "regex": "(?:true|false|null)\\b", "token": "atom" },
              { "regex": "[A-Z][\\w$]*", "token": "type" },
              { "regex": "0[xX][0-9a-fA-F][0-9a-fA-F_]*[lL]?|0[bB][01][01_]*[lL]?", "token": "number" },
              { "regex": "\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?[lLfFdD]?|\\.\\d[\\d_]*(?:[eE][+-]?\\d+)?[fFdD]?", "token": "number" },
              { "regex": "[a-z_$][\\w$]*", "token": "variable" },
              { "regex": "->|::|\\.\\.\\.|>>>=?|<<=?|>>=?|\\+\\+|--|&&|\\|\\||[-+*/%&|^!=<>]=?|[~?:]", "token": "operator" },
              { "regex": "[()\\[\\]{}]", "token": "bracket" },
              { "regex": "[,;.]", "token": "punctuation" }
            ],
            "docComment": [
              { "regex": "\\*/", "token": "comment", "pop": true },
              { "regex": "@[A-Za-z]+", "token": "meta" },
              { "regex": "[^*@]+", "token": "comment" },
              { "regex": "[*@]", "token": "comment" }
            ],
            "blockComment": [
              { "regex": "\\*/", "token": "comment", "pop": true },
              { "regex": "[^*]+", "token": "comment" },
              { "regex": "\\*", "token": "comment" }
            ],
            "string": [
              { "regex": "\\\\(?:u+[0-9a-fA-F]{4}|[0-7]{1,3}|.)", "token": "string-2" },
              { "regex": "\"", "token": "string", "pop": true },
              { "regex": "[^\"\\\\]+", "token": "string" }
            ],
            "textBlock": [
              { "regex": "\"\"\"", "token": "string", "pop": true },
              { "regex": "\\\\(?:u+[0-9a-fA-F]{4}|[0-7]{1,3}|.)", "token": "string-2" },
              { "regex": "\\\\$", "token": "string-2" },
              { "regex": "[^\"\\\\]+", "token": "string" },
              { "regex": "\"", "token": "string" }
            ],
            "defName": [
              { "regex": "\\s+", "token": null },
              { "regex": "[A-Za-z_$][\\w$]*", "token": "def", "pop": true },
              { "regex": ".", "token": null, "pop": true }
            ]
          }
        }
      }
    ]
  }
}
